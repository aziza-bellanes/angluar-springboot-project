# Copy to .env (never commit .env). Values below are for local development only.
MYSQL_DATABASE=atelier
MYSQL_USER=atelier
MYSQL_PASSWORD=atelier_dev_password
MYSQL_ROOT_PASSWORD=atelier_root_dev
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
BOOTSTRAP_ADMIN_EMAIL=admin@atelier.local
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@atelier.local

# Browser origin used by email links; allowed REST/WebSocket origin.
PUBLIC_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200
MAIL_FROM=noreply@atelier.local
# Mailpit catches messages locally. For real delivery use your provider settings.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
