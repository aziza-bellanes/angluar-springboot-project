digraph Database {
graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.0, pad=0.3, splines=polyline];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#315c91"];
roles [label=<<TABLE BORDER="1" COLOR="#b5c5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#101d35"><FONT COLOR="#f4edde"><B>roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">libelle</TD><TD ALIGN="LEFT">VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">profile</TD><TD ALIGN="LEFT">VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT">system_key</TD><TD ALIGN="LEFT">VARCHAR(32) ?</TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" COLOR="#b5c5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#101d35"><FONT COLOR="#f4edde"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(190)</TD></TR><TR><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(30) ?</TD></TR><TR><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP(6)</TD></TR></TABLE>>];
user_roles [label=<<TABLE BORDER="1" COLOR="#b5c5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#101d35"><FONT COLOR="#f4edde"><B>user_roles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK user_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">PK FK role_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
artists [label=<<TABLE BORDER="1" COLOR="#b5c5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#101d35"><FONT COLOR="#f4edde"><B>artists</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(190)</TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(30) ?</TD></TR><TR><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT">VARCHAR(255) ?</TD></TR><TR><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT">VARCHAR(80) ?</TD></TR><TR><TD ALIGN="LEFT">biography</TD><TD ALIGN="LEFT">VARCHAR(4000) ?</TD></TR><TR><TD ALIGN="LEFT">photo_url</TD><TD ALIGN="LEFT">VARCHAR(500) ?</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">FK created_by_id</TD><TD ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP(6)</TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
exhibitions [label=<<TABLE BORDER="1" COLOR="#b5c5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#101d35"><FONT COLOR="#f4edde"><B>exhibitions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(4000) ?</TD></TR><TR><TD ALIGN="LEFT">budget</TD><TD ALIGN="LEFT">DECIMAL(14, 2)</TD></TR><TR><TD ALIGN="LEFT">duration_days</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">starts_on</TD><TD ALIGN="LEFT">DATE ?</TD></TR><TR><TD ALIGN="LEFT">venue</TD><TD ALIGN="LEFT">VARCHAR(160) ?</TD></TR><TR><TD ALIGN="LEFT">cover_url</TD><TD ALIGN="LEFT">VARCHAR(500) ?</TD></TR><TR><TD ALIGN="LEFT">FK artist_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK created_by_id</TD><TD ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP(6)</TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
artworks [label=<<TABLE BORDER="1" COLOR="#b5c5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#101d35"><FONT COLOR="#f4edde"><B>artworks</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">slug</TD><TD ALIGN="LEFT">VARCHAR(180)</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">VARCHAR(160)</TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(4000) ?</TD></TR><TR><TD ALIGN="LEFT">year_created</TD><TD ALIGN="LEFT">INT ?</TD></TR><TR><TD ALIGN="LEFT">medium</TD><TD ALIGN="LEFT">VARCHAR(120) ?</TD></TR><TR><TD ALIGN="LEFT">dimensions</TD><TD ALIGN="LEFT">VARCHAR(80) ?</TD></TR><TR><TD ALIGN="LEFT">image_url</TD><TD ALIGN="LEFT">VARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">image_credit</TD><TD ALIGN="LEFT">VARCHAR(255) ?</TD></TR><TR><TD ALIGN="LEFT">estimate</TD><TD ALIGN="LEFT">DECIMAL(14, 2) ?</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(16)</TD></TR><TR><TD ALIGN="LEFT">FK artist_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK exhibition_id</TD><TD ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD ALIGN="LEFT">FK created_by_id</TD><TD ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP(6)</TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
auctions [label=<<TABLE BORDER="1" COLOR="#b5c5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#101d35"><FONT COLOR="#f4edde"><B>auctions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK artwork_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">starting_price</TD><TD ALIGN="LEFT">DECIMAL(14, 2)</TD></TR><TR><TD ALIGN="LEFT">current_price</TD><TD ALIGN="LEFT">DECIMAL(14, 2)</TD></TR><TR><TD ALIGN="LEFT">minimum_increment</TD><TD ALIGN="LEFT">DECIMAL(14, 2)</TD></TR><TR><TD ALIGN="LEFT">starts_at</TD><TD ALIGN="LEFT">TIMESTAMP(6)</TD></TR><TR><TD ALIGN="LEFT">ends_at</TD><TD ALIGN="LEFT">TIMESTAMP(6)</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(16)</TD></TR><TR><TD ALIGN="LEFT">bid_count</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK leading_bidder_id</TD><TD ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD ALIGN="LEFT">FK winner_id</TD><TD ALIGN="LEFT">BIGINT ?</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP(6)</TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">BIGINT</TD></TR></TABLE>>];
bids [label=<<TABLE BORDER="1" COLOR="#b5c5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD COLSPAN="2" BGCOLOR="#101d35"><FONT COLOR="#f4edde"><B>bids</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK auction_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">FK bidder_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT">DECIMAL(14, 2)</TD></TR><TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMP(6)</TD></TR></TABLE>>];
users -> user_roles [dir=none, taillabel="1", headlabel="0..*", label="user_id", color="#315c91"];
roles -> user_roles [dir=none, taillabel="1", headlabel="0..*", label="role_id", color="#315c91"];
users -> artists [dir=none, taillabel="0..1", headlabel="0..*", label="created_by_id", color="#a2b3b8"];
artists -> exhibitions [dir=none, taillabel="1", headlabel="0..*", label="artist_id", color="#315c91"];
users -> exhibitions [dir=none, taillabel="0..1", headlabel="0..*", label="created_by_id", color="#a2b3b8"];
artists -> artworks [dir=none, taillabel="1", headlabel="0..*", label="artist_id", color="#315c91"];
exhibitions -> artworks [dir=none, taillabel="0..1", headlabel="0..*", label="exhibition_id", color="#315c91"];
users -> artworks [dir=none, taillabel="0..1", headlabel="0..*", label="created_by_id", color="#a2b3b8"];
artworks -> auctions [dir=none, taillabel="1", headlabel="0..*", label="artwork_id", color="#315c91"];
users -> auctions [dir=none, taillabel="0..1", headlabel="0..*", label="leading_bidder_id", color="#315c91"];
users -> auctions [dir=none, taillabel="0..1", headlabel="0..*", label="winner_id", color="#315c91"];
auctions -> bids [dir=none, taillabel="1", headlabel="0..*", label="auction_id", color="#315c91"];
users -> bids [dir=none, taillabel="1", headlabel="0..*", label="bidder_id", color="#315c91"];
}