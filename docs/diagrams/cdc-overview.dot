digraph Core {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.7, ranksep=0.85];
  node [shape=box, style="rounded,filled", fillcolor="#f4edde", color="#315c91", fontname="DejaVu Sans", fontsize=17, margin="0.22,0.18"];
  edge [dir=none, color="#315c91", fontname="DejaVu Sans", fontsize=16, labeldistance=2.0];
  users [label="User\nPK id\nemail"];
  user_roles [label="user_roles\nPK / FK user_id\nPK / FK role_id"];
  roles [label="Role\nPK id\nlibelle (editable)\nprofile, system_key"];
  artists [label="Artist (Client)\nPK id\nname"];
  exhibitions [label="Exhibition (Projet)\nPK id\nFK artist_id required"];
  users -> user_roles [taillabel="1", headlabel="0..*", label="role assignments"];
  user_roles -> roles [taillabel="0..*", headlabel="1", label="shared roles"];
  artists -> exhibitions [taillabel="1", headlabel="0..*", label="artist_id"];
}
