[Unit]
Description=PSM Smart Manager
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=psm
Group=psm
WorkingDirectory=/opt/psm
EnvironmentFile=/etc/psm/psm.env
ExecStart=/usr/bin/java -jar /opt/psm/psm.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/psm
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
