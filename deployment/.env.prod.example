# Copy to deployment/.env.prod on the VPS and fill every value. Never commit the real file.
PUBLIC_URL=https://atelier.example.com
APP_PORT=8080
ATELIER_VERSION=2.0.0

MYSQL_DATABASE=atelier
MYSQL_USER=atelier
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-random-bytes

BOOTSTRAP_ADMIN_EMAIL=admin@smartsoft-solutions.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@smartsoft-solutions.com
MAIL_FROM=atelier@smartsoft-solutions.com

# SMTP provider (or "mailpit" + 1025 with: --profile mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false

# Load the public-domain demonstration gallery on first start
DEMO_DATA=true
