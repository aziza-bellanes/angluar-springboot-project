# Copy to deployment/.env.prod on the VPS and fill every value. Never commit the real file.
PUBLIC_URL=https://atelier.example.com
# Production Compose uses PUBLIC_URL as the allowed REST/WebSocket origin.
APP_PORT=8080
ATELIER_VERSION=2.0.0

MYSQL_DATABASE=atelier
MYSQL_USER=atelier
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-random-bytes

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
MAIL_FROM=atelier@example.com

# Real SMTP provider; Gmail uses smtp.gmail.com:587 and an app password.
# Local testing only: mailpit:1025, AUTH/TLS false, --profile mailpit.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true

# Load the public-domain demonstration gallery on first start
DEMO_DATA=false
