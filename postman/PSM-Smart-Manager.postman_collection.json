{
  "info": {
    "name": "PSM Smart Manager API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@psm.local\", \"password\": \"change-this-admin-password\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200)pm.collectionVariables.set('token',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"nom\": \"Test\", \"prenom\": \"Alice\", \"email\": \"alice@psm.local\", \"password\": \"Password123!\"}"
        }
      }
    },
    {
      "name": "Clients List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/clients"
      }
    },
    {
      "name": "Clients Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clients",
        "body": {
          "mode": "raw",
          "raw": "{\"nom\": \"ACME\", \"email\": \"contact@acme.test\", \"tel\": \"12345678\", \"adresse\": \"Tunis\"}"
        }
      }
    },
    {
      "name": "Projects List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/projets"
      }
    },
    {
      "name": "Projects Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/projets",
        "body": {
          "mode": "raw",
          "raw": "{\"libelle\": \"Portail client\", \"description\": \"Projet démo\", \"budget\": 3000, \"duree\": 30, \"dateDebut\": \"2026-11-01\", \"dateFin\": \"2026-12-01\", \"statut\": \"EN_COURS\", \"progression\": 10, \"clientId\": 1}"
        }
      }
    },
    {
      "name": "Dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/dashboard/stats"
      }
    },
    {
      "name": "Admin Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/users"
      }
    }
  ]
}